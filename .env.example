# 本番URL（オリジンのみ）。未設定のあいだは canonical / OG / sitemap を出さず、
# robots.txt を Disallow にして、プレビューURLの誤インデックスを防ぎます。
NEXT_PUBLIC_SITE_URL=

# ブログ自動生成（GitHub Actions のシークレットに登録します）
ANTHROPIC_API_KEY=

# お問い合わせフォームの送信先（JSONをPOSTします）。
# Formspree / Google Apps Script / Slack の Incoming Webhook などのURLを入れてください。
# 未設定のあいだは、フォームから送信すると「お電話ください」の案内が出ます。
CONTACT_WEBHOOK_URL=
